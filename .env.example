# Database Configuration
MONGO_URI=mongodb://admin:password123@localhost:27017/api-testing-tools?authSource=admin
MONGO_DB_NAME=api-testing-tools

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=API Testing Tools

# Docker Configuration (for docker-compose)
# These are used when running with Docker
DOCKER_MONGO_URI=mongodb://admin:password123@mongodb:27017/api-testing-tools?authSource=admin
DOCKER_CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Email Configuration (optional, for future features)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Redis Configuration (optional, for session storage)
# REDIS_URL=redis://localhost:6379

# Analytics (optional)
# GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_PASSWORD_RESET=false
ENABLE_EMAIL_VERIFICATION=false
